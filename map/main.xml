
<metadata>
	<name>MAIN MENU</name>
	<title>Main Title</title>
	<keyframes>
		<animation name="fade-right">
			<keyframe t="0%" a="
			 	opacity: 0%;
				right: 11em;
			 " />
			<keyframe t="100%" a="
			 	opacity: 100%;
				right: 0em;
			 " />
		</animation>
		<animation name="hover">
			<keyframe t="0%" a="
			 	--red: 0%;
				top: 11em;
			 " />
			<keyframe t="500%" a="
			 	opacity: 100%;
				right: 0em;
			 " />
		</animation>
	</keyframes>
	<script>
		"use-strict";
		let d = document.getElementsByTagName("JETK-head-button");
		console.log(d);
		let isConfirm = true;
		let fun = (event) => {
			//console.log (event.target.scrollTop, contentSize.height);'
			let l = ((event.target.scrollTop / contentSize.height) > 0.9);
			if (isConfirm !== (l)) {
				isConfirm = (l);
				for (let gi = 0; gi < 3; gi++) {
					let g = d[gi];
					g.style.display = (isConfirm && gi != 0) ? "flex" : "none";	
				}
			}
			
		}
		for (let ts of ["scroll", 'resize']) content.addEventListener(ts, event => {fun(event)});
		fun({target: {	
			scrollTop: -1
		}});
	</script>

	<style>	
	</style>
	
</metadata>
